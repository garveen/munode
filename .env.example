# MuNode Rust — Production Environment Configuration
# Copy this file to .env and adjust the values for your deployment.
#
# ─────────────────────────────────────────────────────────────────
# BUILDX BUILDER
# ─────────────────────────────────────────────────────────────────
# Docker Buildx builder to use for `docker compose build`.
# The builder must exist on the build machine.
#
# Standard setup (no proxy):
#   docker buildx create --name munode-builder --driver docker-container --bootstrap
#
# Proxy-aware setup: the docker-container driver runs BuildKit in its own
# container, so HTTP_PROXY / HTTPS_PROXY must be injected via --driver-opt
# rather than via ARG / --build-arg (those only apply after the base image
# is pulled; proxy is needed earlier to fetch the image manifest):
#
#   docker buildx create \
#     --name munode-builder \
#     --driver docker-container \
#     --driver-opt env.HTTP_PROXY=http://user:pass@proxy.example.com:port \
#     --driver-opt env.HTTPS_PROXY=http://user:pass@proxy.example.com:port \
#     --driver-opt env.NO_PROXY=localhost,127.0.0.1 \
#     --bootstrap
#
# To recreate an existing builder: docker buildx rm munode-builder && re-run above.
#
BUILDX_BUILDER=munode-builder
#
# ─────────────────────────────────────────────────────────────────
# HOST USER MAPPING
# ─────────────────────────────────────────────────────────────────
# The server process inside the container runs as this UID:GID, and files
# written to mounted volumes (data/, logs/) will be owned by this UID:GID
# on the host.  Set these to match the host user who owns the project
# directory so volume files are readable/deletable without sudo.
#
# Quick setup: echo "MUNODE_UID=$(id -u)" >> .env && echo "MUNODE_GID=$(id -g)" >> .env
#
# Note: do NOT use UID/GID — they clash with bash read-only built-ins and
# cannot be reliably overridden via .env in Docker Compose v2.
#
MUNODE_UID=1000
MUNODE_GID=1000
#
# ─────────────────────────────────────────────────────────────────
# DEPLOYMENT MODE — uncomment exactly ONE of the COMPOSE_FILE lines
# ─────────────────────────────────────────────────────────────────
#
# 1) Hub + Edge on the same machine (default / all-in-one):
COMPOSE_FILE=docker-compose.hub.yml:docker-compose.edge.yml
#
# 2) Hub only (dedicated hub node; edge servers run elsewhere):
# COMPOSE_FILE=docker-compose.hub.yml
#
# 3) Edge only (connects to a remote hub; set HUB_HOST below):
# COMPOSE_FILE=docker-compose.edge.yml
#
# Default workflow:
#   docker compose build
#   docker compose up -d
# or:
#   docker compose up -d --build
#
# Optional build-only entrypoint when you only want to prebuild images:
#   docker compose -f docker-compose.build.yml build


# Runtime image tags produced by docker-compose.build.yml.
# Override these if you want to publish/pull role-specific images from a registry.
MUNODE_HUB_IMAGE=munode-hub:latest
MUNODE_EDGE_IMAGE=munode-edge:latest

# ─────────────────────────────────────
# Hub configuration
# ─────────────────────────────────────

# TOML config file to mount into the hub container
HUB_CONFIG=./config/hub.toml

# Host port to expose the Hub gRPC service on
HUB_GRPC_PORT=8443

# Host port for the Hub Web API
HUB_WEB_API_PORT=127.0.0.1:8080

# Persistent data directory (SQLite database, blob storage, etc.)
DATA_DIR=./data

# ─────────────────────────────────────
# Edge configuration
# ─────────────────────────────────────

# TOML config file to mount into the edge container
EDGE_CONFIG=./config/edge.toml

# Host port for Mumble clients (TCP + UDP)
MUMBLE_PORT=64738

# Edge-to-Edge port number.
# The same port number is used for:
#   - UDP peer voice routing
#   - TCP/WebSocket /relay bootstrap to Hub via another edge
#   - TCP/WebSocket /voice direct edge-to-edge voice channel
EDGE_PORT=64739

# Host port for the Edge Web API (bind to 127.0.0.1 to avoid public exposure)
EDGE_WEB_API_PORT=127.0.0.1:8081

# WebTransport (QUIC / HTTP3) + WebSocket fallback port.
# Both share the same port number: WebTransport uses UDP (QUIC), WebSocket uses TCP.
# Defaults to network.port + 2 = 64740. Expose publicly; configure ws_fallback_port
# in edge.toml if you need a different value (it defaults to this port automatically).
WT_PORT=64740

# TLS certificate source files on the HOST (picked up by Docker secrets).
# These files can have any permissions on the host — Docker secrets mount
# them inside the container as /run/secrets/tls_cert and /run/secrets/tls_key
# (read-only, root-owned).  The entrypoint copies them to /app/secrets/ with
# correct ownership so the unprivileged munode user can read them.
#
# The edge.toml must reference the copied paths:
#   cert = "/app/secrets/tls_cert"
#   key  = "/app/secrets/tls_key"
#
# For bare-metal (non-Docker) deployments, ignore these variables and set
# the paths directly in edge.toml instead.
TLS_CERT=./certs/server.pem
TLS_KEY=./certs/server.key

# The Hub connection address and port for this Edge are configured in
# the edge JSON config file (hub_server.host / hub_server.control_port),
# not via environment variables.

# ─────────────────────────────────────
# Shared
# ─────────────────────────────────────

# Log directory (sub-directories hub/ and edge/ are created automatically)
LOG_DIR=./logs

# Rust log level: error | warn | info | debug | trace
RUST_LOG=info
