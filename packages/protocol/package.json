{
  "name": "@munode/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node esbuild.config.mjs && tsc --emitDeclarationOnly --outDir dist",
    "dev": "node esbuild.config.mjs --watch",
    "clean": "rm -rf dist *.tsbuildinfo src/generated/proto",
    "generate:proto": "protoc --proto_path=./proto --ts_out=service=grpc-node:./src/generated/proto ./proto/Mumble.proto ./proto/HubEdgeSync.proto ./proto/HubEdge.proto",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@munode/common": "workspace:*",
    "google-protobuf": "^4.0.1",
    "protoc": "^33.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "protoc-gen-ts": "^0.8.7",
    "typescript": "^5.9.3"
  }
}
